# /etc/caddy/Caddyfile on the VPS.  Caddy gets and renews HTTPS certificates by itself.
# TODO: replace every domain below with yours, and point each one's DNS A record at the VPS IP first.

# --- StockPro: the app (static files) + its API on one hostname -------------
stock.example.com {
	encode zstd gzip

	# API -> the Node server (PM2 runs it on 127.0.0.1:5000)
	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	# Everything else -> the built client (client/dist copied to /var/www/stockpro)
	handle {
		root * /var/www/stockpro
		try_files {path} /index.html
		file_server
	}

	# Never let the browser cache the service worker or index page
	@noCache path /sw.js /index.html /registerSW.js /manifest.webmanifest
	header @noCache Cache-Control "no-cache"
	# Hashed build files never change, cache them hard
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

# --- Sagec: public website (Vite build, static) ------------------------------
sagec.example.com {
	encode zstd gzip
	root * /var/www/sagec
	try_files {path} /index.html
	file_server
}

# --- Sagec: Payload CMS admin + API (Next.js on 127.0.0.1:3000) ----------------
cms.sagec.example.com {
	encode zstd gzip
	# Large enough for photo uploads in the admin
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:3000
}
